from did import did_reg

def callaway_santanna_did(df, unit, time, treat_time, outcome):
    """
    TODO: Implement CS (2021) staggered DiD estimator
    
    Key steps:
    1. Define cohorts based on treatment timing
    2. For each (cohort, time) pair, compute ATT(g,t)
    3. Aggregate to overall ATT
    
    Hint: Use never-treated units as control
    """
    # Get treatment cohorts
    cohorts = df[df[treat_time] < np.inf][treat_time].unique()
    
    att_gt = {}
    for g in cohorts:  # cohort (treatment group)
        for t in df[time].unique():  # time period
            if t >= g:  # post-treatment
                # TODO: Define treatment and control groups
                treated = (df[treat_time] == ___) & (df[time] == ___)
                never_treated = (df[treat_time] == ___) & (df[time] == ___)
                
                # TODO: Compute pre-treatment differences
                # Find pre-period (g-1 or earlier)
                pre_period = ___
                
                # Compute DiD for this (g,t) pair
                treated_post = df.loc[treated, outcome].mean()
                treated_pre = df.loc[(df[treat_time]==g) & (df[time]==pre_period), outcome].mean()
                control_post = df.loc[never_treated & (df[time]==t), outcome].mean()
                control_pre = df.loc[never_treated & (df[time]==pre_period), outcome].mean()
                
                att_gt[(g,t)] = (treated_post - treated_pre) - (___ - ___)
    
    # Aggregate ATT(g,t) to overall ATT
    att = np.mean(list(att_gt.values()))
    return att, att_gt

