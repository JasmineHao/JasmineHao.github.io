    <script>
    function showPattern(id) {
      document.querySelectorAll('.pattern-content').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.pattern-tab').forEach(t => t.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      const patterns = ['pattern1', 'pattern2', 'pattern3'];
      document.querySelectorAll('.pattern-tab')[patterns.indexOf(id)].classList.add('active');
    }
