      colabUrl:'https://colab.research.google.com/github/JasmineHao/JasmineHao.github.io/blob/main/econ6083/notebooks/Lecture08-DML-IV-Exercise.ipynb' }
  },
  { num:'L09', week:'Apr 24 (Fri)', color:'blue',
    title:'Difference-in-Differences & RDD',
    desc:'Modern DiD with staggered adoption, Callaway\u2013Sant\u2019Anna estimator, sharp and fuzzy RDD.',
    releaseDate: new Date('2026-04-23'),
    url:'slides/Lecture09-Difference-in-Differences-and-RDD-Slides.pdf',
    exercise: { title:'DiD & RDD',
      desc:'Replicate the Card & Krueger (1994) minimum wage DiD and implement a sharp RDD.',
      url:'notebooks/Lecture09-DiD-RDD-Exercise.ipynb',
      colabUrl:'https://colab.research.google.com/github/JasmineHao/JasmineHao.github.io/blob/main/econ6083/notebooks/Lecture09-DiD-RDD-Exercise.ipynb' }
  },
  { num:'L10', week:'Apr 28 (Tue)', color:'blue',
    title:'Optimal Policy Learning & Text as Data',
    desc:'Empirical welfare maximization, policy trees, text embeddings, sentiment analysis in economics.',
    releaseDate: new Date('2026-04-27'),
    url:'slides/Lecture10-Optimal-Policy-Learning-and-Text-as-Data-Slides.pdf',
    exercise: { title:'Policy Learning & Text as Data',
      desc:'Implement empirical welfare maximization and explore text embeddings for economic analysis.',
      url:'notebooks/Lecture10-Policy-Learning-Exercise.ipynb',
      colabUrl:'https://colab.research.google.com/github/JasmineHao/JasmineHao.github.io/blob/main/econ6083/notebooks/Lecture10-Policy-Learning-Exercise.ipynb' }
  }
];

function buildSlidesContent() {
  const now = new Date();
  const container = document.getElementById('slides-content');
  let html = '';
  LECTURES.forEach(lec => {
    const released = now >= lec.releaseDate;
    const relStr = lec.releaseDate.toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'});

    // Lecture divider header
    html += `<div class="lecture-divider">
      <div class="lec-badge ${released ? '' : 'locked'}">${lec.num}</div>
      <div class="lec-title ${released ? '' : 'locked'}">${lec.title}</div>
      <div class="lec-line"></div>
      <div class="lec-date">${lec.week}</div>
    </div>`;

    // Side-by-side: slide (left) + exercise (right)
    html += `<div class="lecture-row-flex">`;

    if (released) {
      // Slide card
      html += `<div class="card ${lec.color}">
        <div class="card-week">Lecture Slides</div>
        <div class="card-num">${lec.num}</div>
        <h3>${lec.title}</h3>
        <div class="card-desc">${lec.desc}</div>
        <div class="card-actions">
          <a class="btn btn-primary" href="${lec.url}" target="_blank" download>\u25B6 Download PDF</a>
        </div>
      </div>`;

      // Exercise card
      if (lec.exercise) {
        html += `<div class="card teal">
          <div class="card-week">In-Class Exercise</div>
          <h3>${lec.exercise.title}</h3>
          <div class="card-desc">${lec.exercise.desc}</div>
          <div class="card-actions">
            <a class="btn btn-colab" href="${lec.exercise.colabUrl}" target="_blank"><img src="https://colab.research.google.com/assets/colab-badge.svg" alt="Open in Colab" style="height:20px;vertical-align:middle;"></a>
          </div>
        </div>`;
      }
    } else {
      // Locked slide
      html += `<div class="card" style="opacity:0.6;">
        <div class="card-week">Lecture Slides</div>
        <div class="card-num" style="color:#A0AEC0;">${lec.num}</div>
        <h3 style="color:#A0AEC0;">${lec.title}</h3>
        <div class="card-desc" style="color:#CBD5E0;">Available from ${relStr}</div>
        <div class="card-actions"><span class="btn btn-locked">\uD83D\uDD12 Locked</span></div>
      </div>`;

      // Locked exercise
      if (lec.exercise) {
        html += `<div class="card locked-overlay" style="opacity:0.6;">
          <span class="lock-badge">\uD83D\uDD12 Locked</span>
          <div class="card-week">In-Class Exercise</div>
          <h3 style="color:#A0AEC0;">${lec.exercise.title}</h3>
          <div class="card-desc" style="color:#CBD5E0;">Available from ${relStr}</div>
          <div class="card-actions"><span class="btn btn-locked">\uD83D\uDD12 Locked</span></div>
        </div>`;
      }
    }

    html += `</div>`;
  });
  container.innerHTML = html;
}

buildSlidesContent();
</script>

</body>
</html>
